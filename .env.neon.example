# Copie a .env.neon (NO se sube a GitHub) y rellene con los datos de su proyecto de Neon.
# Neon -> su proyecto -> botón «Connect»: Branch = production, Database = neondb, Role = neondb_owner,
# y DESACTIVE «Connection pooling» (conexión directa). De la cadena de conexión copie SOLO el host (lo que va tras @ y antes de /).
NEON_HOST=ep-xxxxxx.eu-west-2.aws.neon.tech
NEON_DB=neondb
NEON_OWNER_USER=neondb_owner
NEON_OWNER_PASSWORD=
# NEON_APP_PASSWORD lo genera el script la primera vez (clave del rol fitona_app) y lo añade a este archivo.
