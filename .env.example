# Copie este archivo a .env y cambie las claves. NUNCA suba .env al repositorio.
# Solo para desarrollo local: en producción las credenciales van en un gestor de secretos.
ORACLE_SYS_PASSWORD=CambiaEsto_Sys_1
FITONA_OWNER_PASSWORD=CambiaEsto_Owner_1
FITONA_APP_PASSWORD=CambiaEsto_App_1
ORACLE_PORT=1521
# Opcional: usar otro registro si Docker Hub limita las descargas
# ORACLE_IMAGE=mirror.gcr.io/gvenzl/oracle-free:23-slim-faststart
# FLYWAY_IMAGE=mirror.gcr.io/flyway/flyway:13.12.2
# Puertos en tu equipo (por si 4200/8080/1521 están ocupados)
# WEB_PORT=4200
# BACKEND_PORT=8080
# Opcional: otros registros de imágenes base
# MAVEN_IMAGE=maven:3.9-eclipse-temurin-21
# JRE_IMAGE=eclipse-temurin:21-jre
# NODE_IMAGE=node:22-alpine
# NGINX_IMAGE=nginx:1.27-alpine

# Solo en producción (docker-compose.prod.yml): dominio con HTTPS
FITONA_DOMAIN=
